# ---------- Server ----------
PORT=5000
NODE_ENV=development
# Comma separated list of allowed frontend origins (CORS)
CLIENT_URL=http://localhost:5173
# Public URL of the website (used in sitemap.xml)
SITE_URL=http://localhost:5173

# ---------- Database ----------
MONGODB_URI=mongodb://127.0.0.1:27017/moraqqa

# ---------- Auth ----------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# ---------- Cloudinary (never expose the secret to the frontend) ----------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_ROOT_FOLDER=moraqqa

# ---------- Seed admin ----------
ADMIN_EMAIL=admin@moraqqa.com
ADMIN_PASSWORD=ChangeMe!2026

# ---------- Contact ----------
# Digits only, with country code (e.g. 919876543210)
WHATSAPP_NUMBER=
